{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "node -e \"try { fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('node_modules/.vite', { recursive: true, force: true }); } catch (e) {}\"",
    "clean:cache": "node -e \"try { fs.rmSync('.cache', { recursive: true, force: true }); fs.rmSync('.temp', { recursive: true, force: true }); } catch (e) {}\"",
    "prebuild": "npm run clean",
    "dev": "vite",
    "build": "vite build && node -e \"try { fs.copyFileSync('dist/index.html', 'dist/200.html'); } catch (e) {}\"",
    "build:dev": "vite build --mode development",
    "cap:sync": "cap sync android",
    "cap:build": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "lint": "eslint .",
    "preview": "vite preview"
  },
